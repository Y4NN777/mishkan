{
  "$defs": {
    "BrowserActionKind": {
      "enum": [
        "click",
        "coordinate_click",
        "fill",
        "press",
        "select",
        "check",
        "upload",
        "navigate",
        "javascript"
      ],
      "title": "BrowserActionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coordinates": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coordinates"
    },
    "credential_origin": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Origin"
    },
    "credential_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Reference"
    },
    "expected_session_revision": {
      "minimum": 0,
      "title": "Expected Session Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/BrowserActionKind"
    },
    "observation_id": {
      "format": "uuid",
      "title": "Observation Id",
      "type": "string"
    },
    "page_id": {
      "minLength": 1,
      "title": "Page Id",
      "type": "string"
    },
    "resolved_effect": {
      "minLength": 1,
      "title": "Resolved Effect",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "target_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Reference"
    },
    "value": {
      "default": null,
      "title": "Value"
    },
    "visual_evidence_artifact_reference": {
      "anyOf": [
        {
          "pattern": "^artifact:[0-9a-f-]{36}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Evidence Artifact Reference"
    }
  },
  "required": [
    "session_id",
    "page_id",
    "observation_id",
    "kind",
    "resolved_effect",
    "expected_session_revision"
  ],
  "title": "BrowserActionRequest",
  "type": "object"
}
