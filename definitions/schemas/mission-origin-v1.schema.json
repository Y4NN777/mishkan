{
  "$defs": {
    "MissionOriginKind": {
      "enum": [
        "ceo",
        "pm",
        "cto",
        "incident",
        "project_evidence",
        "independent_finding",
        "dependency",
        "maintenance",
        "organizational_proposal"
      ],
      "title": "MissionOriginKind",
      "type": "string"
    },
    "MissionTemplateReference": {
      "additionalProperties": false,
      "description": "Exact immutable identity of optional mission guidance used by a plan.",
      "properties": {
        "catalogue_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Catalogue Id",
          "type": "string"
        },
        "catalogue_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Catalogue Revision",
          "type": "string"
        },
        "definition_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Fingerprint",
          "type": "string"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "template_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Template Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "version",
        "source",
        "provenance",
        "catalogue_id",
        "catalogue_revision",
        "definition_fingerprint"
      ],
      "title": "MissionTemplateReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/MissionOriginKind"
    },
    "objective": {
      "maxLength": 8192,
      "minLength": 3,
      "title": "Objective",
      "type": "string"
    },
    "origin_id": {
      "format": "uuid",
      "title": "Origin Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "source_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "template_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Id"
    },
    "template_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissionTemplateReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind",
    "actor_id",
    "objective"
  ],
  "title": "MissionOrigin",
  "type": "object"
}
