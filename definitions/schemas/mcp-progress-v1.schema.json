{
  "$defs": {
    "McpElicitationAction": {
      "enum": [
        "accept",
        "decline",
        "cancel"
      ],
      "title": "McpElicitationAction",
      "type": "string"
    },
    "McpProgressKind": {
      "enum": [
        "progress",
        "elicitation"
      ],
      "title": "McpProgressKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cursor": {
      "minimum": 0,
      "title": "Cursor",
      "type": "integer"
    },
    "elicitation_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpElicitationAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "elicitation_content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elicitation Content Hash"
    },
    "elicitation_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elicitation Mode"
    },
    "elicitation_request_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elicitation Request Hash"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/McpProgressKind",
      "default": "progress"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "progress": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "total": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    }
  },
  "required": [
    "request_id",
    "cursor"
  ],
  "title": "McpProgressEvent",
  "type": "object"
}
