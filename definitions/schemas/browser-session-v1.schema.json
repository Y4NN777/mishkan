{
  "$defs": {
    "BrowserProfileKind": {
      "enum": [
        "isolated",
        "project_persistent",
        "attached_existing"
      ],
      "title": "BrowserProfileKind",
      "type": "string"
    },
    "BrowserSessionState": {
      "enum": [
        "opening",
        "active",
        "closing",
        "closed",
        "lost",
        "failed",
        "uncertain"
      ],
      "title": "BrowserSessionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "owner_identity": {
      "title": "Owner Identity",
      "type": "string"
    },
    "page_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Page Ids",
      "type": "array"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_kind": {
      "$ref": "#/$defs/BrowserProfileKind"
    },
    "profile_state_artifact_reference": {
      "anyOf": [
        {
          "pattern": "^artifact:[0-9a-f-]{36}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile State Artifact Reference"
    },
    "retention": {
      "title": "Retention",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "title": "Sensitivity",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/BrowserSessionState"
    },
    "task_attempt_id": {
      "title": "Task Attempt Id",
      "type": "string"
    },
    "uncertain_effect": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertain Effect"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "profile_kind",
    "owner_identity",
    "run_id",
    "task_attempt_id",
    "workspace",
    "adapter",
    "engine",
    "engine_version",
    "state",
    "revision",
    "sensitivity",
    "retention"
  ],
  "title": "BrowserSession",
  "type": "object"
}
