{
  "$defs": {
    "McpEffectDisposition": {
      "enum": [
        "read_only",
        "idempotent",
        "non_idempotent",
        "unknown"
      ],
      "title": "McpEffectDisposition",
      "type": "string"
    },
    "McpElicitationAction": {
      "enum": [
        "accept",
        "decline",
        "cancel"
      ],
      "title": "McpElicitationAction",
      "type": "string"
    },
    "McpElicitationAnswer": {
      "additionalProperties": false,
      "description": "One pre-authorized answer bound to an exact normalized server request.",
      "properties": {
        "action": {
          "$ref": "#/$defs/McpElicitationAction"
        },
        "content": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "expected_request_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Expected Request Hash",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "expected_request_hash",
        "action"
      ],
      "title": "McpElicitationAnswer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": true,
      "title": "Arguments",
      "type": "object"
    },
    "caller_identity": {
      "minLength": 1,
      "title": "Caller Identity",
      "type": "string"
    },
    "connection_id": {
      "minLength": 1,
      "title": "Connection Id",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "declared_effects": {
      "items": {
        "type": "string"
      },
      "title": "Declared Effects",
      "type": "array"
    },
    "effect_disposition": {
      "$ref": "#/$defs/McpEffectDisposition"
    },
    "elicitation_answers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/McpElicitationAnswer"
      },
      "title": "Elicitation Answers",
      "type": "array"
    },
    "expected_schema_hash": {
      "minLength": 1,
      "title": "Expected Schema Hash",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "primitive_name": {
      "minLength": 1,
      "title": "Primitive Name",
      "type": "string"
    },
    "remote_task_allowed": {
      "default": false,
      "title": "Remote Task Allowed",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_attempt_id": {
      "minLength": 1,
      "title": "Task Attempt Id",
      "type": "string"
    }
  },
  "required": [
    "connection_id",
    "primitive_name",
    "caller_identity",
    "run_id",
    "task_attempt_id",
    "arguments",
    "declared_effects",
    "effect_disposition",
    "expected_schema_hash",
    "deadline"
  ],
  "title": "McpCallRequest",
  "type": "object"
}
