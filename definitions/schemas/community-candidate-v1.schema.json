{
  "$defs": {
    "CandidateConstraints": {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "$ref": "#/$defs/ConstraintState"
        },
        "execution": {
          "$ref": "#/$defs/ConstraintState"
        },
        "policy": {
          "$ref": "#/$defs/ConstraintState"
        },
        "trust": {
          "$ref": "#/$defs/ConstraintState"
        }
      },
      "required": [
        "compatibility",
        "policy",
        "trust",
        "execution"
      ],
      "title": "CandidateConstraints",
      "type": "object"
    },
    "CandidateKind": {
      "enum": [
        "tool",
        "mcp_server",
        "plugin",
        "skill",
        "technical_pack"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "CandidateSourceKind": {
      "enum": [
        "configured_catalogue",
        "official_documentation",
        "registry",
        "repository",
        "hub"
      ],
      "title": "CandidateSourceKind",
      "type": "string"
    },
    "ConstraintState": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "title": "ConstraintState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/CandidateConstraints"
    },
    "criterion_values": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 64,
      "title": "Criterion Values",
      "type": "object"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence References",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/CandidateKind"
    },
    "maintenance_evidence": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Evidence"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "overlap": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Overlap",
      "type": "array"
    },
    "revision": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/CandidateSourceKind"
    },
    "source_locator": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Source Locator",
      "type": "string"
    },
    "trust_evidence": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trust Evidence"
    },
    "version": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "candidate_id",
    "kind",
    "name",
    "revision",
    "source_kind",
    "source_locator",
    "observed_at",
    "evidence_references",
    "constraints"
  ],
  "title": "CommunityCandidate",
  "type": "object"
}
