{
  "$defs": {
    "MessagePurpose": {
      "enum": [
        "discussion",
        "collaboration",
        "consultation",
        "handoff_context",
        "review",
        "evidence_challenge"
      ],
      "title": "MessagePurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author_identity": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Author Identity",
      "type": "string"
    },
    "body": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/MessagePurpose",
      "default": "discussion"
    },
    "reply_to_message_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply To Message Id"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    }
  },
  "required": [
    "conversation_id",
    "author_identity",
    "body"
  ],
  "title": "ConversationMessage",
  "type": "object"
}
