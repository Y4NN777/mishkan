        },
        "exposure_profile": {
          "minLength": 1,
          "title": "Exposure Profile",
          "type": "string"
        },
        "stdio_bridge_enabled": {
          "title": "Stdio Bridge Enabled",
          "type": "boolean"
        },
        "streamable_http_path": {
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$",
          "title": "Streamable Http Path",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "streamable_http_path",
        "stdio_bridge_enabled",
        "exposure_profile"
      ],
      "title": "McpFacadeConfig",
      "type": "object"
