{
  "$defs": {
    "ArtifactConfig": {
      "additionalProperties": false,
      "properties": {
        "chunk_bytes": {
          "minimum": 1,
          "title": "Chunk Bytes",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "minimum": 1,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "staging_ttl_seconds": {
          "minimum": 1,
          "title": "Staging Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "root",
        "max_artifact_bytes",
        "chunk_bytes",
        "staging_ttl_seconds"
      ],
      "title": "ArtifactConfig",
      "type": "object"
    },
    "CredentialReference": {
      "additionalProperties": false,
      "description": "A late-resolution locator; never a credential value.",
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CredentialSource"
        }
      },
      "required": [
        "source",
        "locator"
      ],
      "title": "CredentialReference",
      "type": "object"
    },
    "CredentialSource": {
      "enum": [
        "env",
        "file",
        "keyring",
        "command"
      ],
      "title": "CredentialSource",
      "type": "string"
    },
    "CrewAIRuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "max_agent_iterations": {
          "default": 4,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Agent Iterations",
          "type": "integer"
        },
        "model_max_output_tokens": {
          "default": 2048,
          "maximum": 131072,
          "minimum": 128,
          "title": "Model Max Output Tokens",
          "type": "integer"
        },
        "model_timeout_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 10,
          "title": "Model Timeout Seconds",
          "type": "integer"
        },
        "model_transport_retries": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Model Transport Retries",
          "type": "integer"
        },
        "plan_validation_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Plan Validation Retries",
          "type": "integer"
        },
        "review_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Review Retries",
          "type": "integer"
        },
        "structured_output_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Structured Output Retries",
          "type": "integer"
        },
        "task_execution_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Task Execution Retries",
          "type": "integer"
        },
        "telemetry": {
          "default": false,
          "title": "Telemetry",
          "type": "boolean"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "tracing": {
          "default": false,
          "title": "Tracing",
          "type": "boolean"
        }
      },
      "title": "CrewAIRuntimeConfig",
      "type": "object"
    },
    "DaemonConfig": {
      "additionalProperties": false,
      "properties": {
        "event_page_limit": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Event Page Limit",
          "type": "integer"
        },
        "event_poll_seconds": {
          "maximum": 30,
          "minimum": 0.05,
          "title": "Event Poll Seconds",
          "type": "number"
        },
        "heartbeat_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Heartbeat Seconds",
          "type": "integer"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "integer"
        },
        "token_file": {
          "format": "path",
          "title": "Token File",
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "token_file",
        "heartbeat_seconds",
        "event_poll_seconds",
        "event_page_limit",
        "request_timeout_seconds"
      ],
      "title": "DaemonConfig",
      "type": "object"
    },
    "ModelCandidate": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelCandidate",
      "type": "object"
    },
    "ModelRoute": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ModelCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "ModelRoute",
      "type": "object"
    },
    "OperatingMode": {
      "enum": [
        "local",
        "cloud",
        "hybrid",
        "distributed"
      ],
      "title": "OperatingMode",
      "type": "string"
    },
    "PersistenceConfig": {
      "additionalProperties": false,
      "properties": {
        "busy_timeout_ms": {
          "maximum": 300000,
          "minimum": 1,
          "title": "Busy Timeout Ms",
          "type": "integer"
        },
        "database": {
          "format": "path",
          "title": "Database",
          "type": "string"
        },
        "event_retention_days": {
          "maximum": 36500,
          "minimum": 1,
          "title": "Event Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "database",
        "busy_timeout_ms",
        "event_retention_days"
      ],
      "title": "PersistenceConfig",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "format": "path",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "title": "ProjectConfig",
      "type": "object"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "credential_pool": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CredentialReference"
          },
          "title": "Credential Pool",
          "type": "array"
        },
        "endpoint": {
          "format": "uri",
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "probe_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Url"
        }
      },
      "required": [
        "kind",
        "endpoint"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "ServiceConfig": {
      "additionalProperties": false,
      "properties": {
        "credential_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CredentialReference"
          },
          "title": "Credential Refs",
          "type": "array"
        },
        "endpoint": {
          "format": "uri",
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "probe_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Url"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "endpoint"
      ],
      "title": "ServiceConfig",
      "type": "object"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "properties": {
        "default_profile": {
          "minLength": 1,
          "title": "Default Profile",
          "type": "string"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/SessionProfileConfig"
          },
          "minProperties": 1,
          "title": "Profiles",
          "type": "object"
        },
        "spool_root": {
          "format": "path",
          "title": "Spool Root",
          "type": "string"
        }
      },
      "required": [
        "spool_root",
        "default_profile",
        "profiles"
      ],
      "title": "SessionConfig",
      "type": "object"
    },
    "SessionProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "cancellation_signals": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cancellation Signals",
          "type": "array"
        },
        "grace_seconds": {
          "maximum": 300,
          "minimum": 0.05,
          "title": "Grace Seconds",
          "type": "number"
        },
        "max_output_bytes": {
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "read_chunk_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Read Chunk Bytes",
          "type": "integer"
        },
        "readiness_poll_seconds": {
          "maximum": 60,
          "minimum": 0.01,
          "title": "Readiness Poll Seconds",
          "type": "number"
        },
        "settle_timeout_seconds": {
          "maximum": 3600,
          "minimum": 0.1,
          "title": "Settle Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "cancellation_signals",
        "grace_seconds",
        "settle_timeout_seconds",
        "max_output_bytes",
        "read_chunk_bytes",
        "readiness_poll_seconds"
      ],
      "title": "SessionProfileConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete effective configuration required before a run can be accepted.",
  "properties": {
    "agent_routes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Agent Routes",
      "type": "object"
    },
    "artifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "crewai": {
      "$ref": "#/$defs/CrewAIRuntimeConfig"
    },
    "daemon": {
      "anyOf": [
        {
          "$ref": "#/$defs/DaemonConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inspection_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inspection Profile"
    },
    "isolation_profiles": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Isolation Profiles",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/OperatingMode"
    },
    "model_routes": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelRoute"
      },
      "minProperties": 1,
      "title": "Model Routes",
      "type": "object"
    },
    "persistence": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersistenceConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Policy Sources",
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "minProperties": 1,
      "title": "Providers",
      "type": "object"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "title": "Services",
      "type": "object"
    },
    "sessions": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "tool_sources": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tool Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "timezone",
    "project",
    "providers",
    "model_routes",
    "policy_sources"
  ],
  "title": "MishkanConfig",
  "type": "object"
}
