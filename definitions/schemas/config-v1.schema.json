        "chunk_bytes": {
          "minimum": 1,
          "title": "Chunk Bytes",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "minimum": 1,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "staging_ttl_seconds": {
          "minimum": 1,
          "title": "Staging Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "root",
        "max_artifact_bytes",
        "chunk_bytes",
        "staging_ttl_seconds"
      ],
      "title": "ArtifactConfig",
      "type": "object"
    },
    "BrowserConfig": {
      "additionalProperties": false,
      "properties": {
        "default_profile": {
          "minLength": 1,
          "title": "Default Profile",
          "type": "string"
        },
        "max_diagnostic_entries": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Diagnostic Entries",
          "type": "integer"
        },
        "max_observation_bytes": {
          "minimum": 1,
          "title": "Max Observation Bytes",
          "type": "integer"
        },
        "observation_ttl_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Observation Ttl Seconds",
          "type": "number"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/BrowserProfileConfig"
          },
          "minProperties": 1,
          "title": "Profiles",
          "type": "object"
        },
        "staging_root": {
          "format": "path",
          "title": "Staging Root",
          "type": "string"
        }
      },
      "required": [
        "staging_root",
        "default_profile",
        "profiles",
        "observation_ttl_seconds",
        "max_observation_bytes",
        "max_diagnostic_entries"
      ],
      "title": "BrowserConfig",
      "type": "object"
    },
    "BrowserProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "action_timeout_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Action Timeout Seconds",
          "type": "number"
        },
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Origins",
          "type": "array"
        },
        "cdp_endpoint": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cdp Endpoint"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "headless": {
          "title": "Headless",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/BrowserProfileKind"
        },
        "max_pages": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "navigation_timeout_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Navigation Timeout Seconds",
          "type": "number"
        },
        "network_profile": {
          "minLength": 1,
          "title": "Network Profile",
          "type": "string"
        },
        "retention": {
          "minLength": 1,
          "title": "Retention",
          "type": "string"
        },
        "sensitivity": {
          "minLength": 1,
          "title": "Sensitivity",
          "type": "string"
        },
        "user_data_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Data Dir"
        }
      },
      "required": [
        "kind",
        "adapter",
        "engine",
        "network_profile",
        "allowed_origins",
        "sensitivity",
        "retention",
        "headless",
        "max_pages",
        "action_timeout_seconds",
        "navigation_timeout_seconds"
