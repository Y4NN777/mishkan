        "prompts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prompts",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        }
