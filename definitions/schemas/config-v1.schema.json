        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/CredentialReference"
          },
          "title": "Environment",
          "type": "object"
