          "additionalProperties": {
            "$ref": "#/$defs/McpConnectionConfig"
          },
          "title": "Connections",
          "type": "object"
        },
        "exposure_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/McpExposureProfileConfig"
