      "type": "object"
    },
    "BrowserProfileKind": {
      "enum": [
        "isolated",
        "project_persistent",
        "attached_existing"
      ],
      "title": "BrowserProfileKind",
      "type": "string"
    },
    "CredentialReference": {
      "additionalProperties": false,
      "description": "A late-resolution locator; never a credential value.",
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CredentialSource"
        }
      },
      "required": [
        "source",
        "locator"
      ],
      "title": "CredentialReference",
      "type": "object"
    },
    "CredentialSource": {
      "enum": [
        "env",
        "file",
        "keyring",
        "command"
      ],
      "title": "CredentialSource",
      "type": "string"
    },
    "CrewAIRuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "max_agent_iterations": {
          "default": 4,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Agent Iterations",
          "type": "integer"
        },
        "model_max_output_tokens": {
          "default": 2048,
          "maximum": 131072,
          "minimum": 128,
          "title": "Model Max Output Tokens",
          "type": "integer"
        },
        "model_timeout_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 10,
          "title": "Model Timeout Seconds",
          "type": "integer"
        },
        "model_transport_retries": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Model Transport Retries",
          "type": "integer"
        },
        "plan_validation_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Plan Validation Retries",
          "type": "integer"
        },
        "review_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Review Retries",
          "type": "integer"
        },
        "structured_output_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Structured Output Retries",
          "type": "integer"
        },
        "task_execution_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Task Execution Retries",
          "type": "integer"
        },
        "telemetry": {
          "default": false,
          "title": "Telemetry",
          "type": "boolean"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "tracing": {
          "default": false,
          "title": "Tracing",
          "type": "boolean"
        }
      },
      "title": "CrewAIRuntimeConfig",
      "type": "object"
    },
    "DaemonConfig": {
      "additionalProperties": false,
      "properties": {
        "event_page_limit": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Event Page Limit",
          "type": "integer"
        },
        "event_poll_seconds": {
          "maximum": 30,
          "minimum": 0.05,
          "title": "Event Poll Seconds",
          "type": "number"
        },
        "heartbeat_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Heartbeat Seconds",
          "type": "integer"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "integer"
        },
        "token_file": {
          "format": "path",
          "title": "Token File",
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "token_file",
        "heartbeat_seconds",
        "event_poll_seconds",
        "event_page_limit",
        "request_timeout_seconds"
      ],
      "title": "DaemonConfig",
      "type": "object"
    },
    "McpConfig": {
      "additionalProperties": false,
      "properties": {
        "cancellation_poll_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Cancellation Poll Seconds",
