{
  "$defs": {
    "ChangeOperation": {
      "additionalProperties": false,
      "properties": {
        "artifact_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Reference"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "destination_precondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreconditionKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "destination_precondition_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Precondition Value"
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Digest"
        },
        "expected_occurrences": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Occurrences"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "inline_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inline Content"
        },
        "kind": {
          "$ref": "#/$defs/ChangeOperationKind"
        },
        "match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "patch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/PreconditionKind"
        },
        "precondition_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precondition Value"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        },
        "result_mode": {
          "anyOf": [
            {
              "maximum": 4095,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Mode"
        },
        "rewrite_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Engine"
        },
        "rewrite_formatting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Formatting"
        },
        "rewrite_ignored_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rewrite Ignored Files",
          "type": "array"
        },
        "rewrite_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Language"
        },
        "rewrite_limits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Rewrite Limits",
          "type": "object"
        },
        "rewrite_matches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Matches"
        },
        "rewrite_parse_failures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rewrite Parse Failures",
          "type": "array"
        },
        "rewrite_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Rule"
        },
        "rewrite_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Scope"
        },
        "rewrite_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Version"
        },
        "rollback": {
          "$ref": "#/$defs/RollbackPolicy",
          "default": "restore"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_preservation_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Preservation Evidence"
        }
      },
      "required": [
        "kind",
        "path",
        "precondition"
      ],
      "title": "ChangeOperation",
      "type": "object"
    },
    "ChangeOperationKind": {
      "enum": [
        "mkdir",
        "create",
        "write",
        "replace",
        "patch",
        "rewrite",
        "move",
        "copy",
        "delete"
      ],
      "title": "ChangeOperationKind",
      "type": "string"
    },
    "ChangeValidation": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeValidationKind"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "ChangeValidation",
      "type": "object"
    },
    "ChangeValidationKind": {
      "enum": [
        "exists",
        "absent",
        "digest",
        "mode"
      ],
      "title": "ChangeValidationKind",
      "type": "string"
    },
    "PreconditionKind": {
      "enum": [
        "absent",
        "digest",
        "revision",
        "git_blob"
      ],
      "title": "PreconditionKind",
      "type": "string"
    },
    "RollbackPolicy": {
      "enum": [
        "restore",
        "retain"
      ],
      "title": "RollbackPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_effects": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Declared Effects",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/ChangeOperation"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "path_scopes": {
      "default": [
        "."
      ],
      "items": {
        "type": "string"
      },
      "title": "Path Scopes",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "validations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChangeValidation"
      },
      "title": "Validations",
      "type": "array"
    },
    "workspace": {
      "default": ".",
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "operations",
    "declared_effects"
  ],
  "title": "ChangeSet",
  "type": "object"
}
