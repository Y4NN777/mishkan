{
  "$defs": {
    "SkillActivationState": {
      "enum": [
        "candidate",
        "active",
        "inactive",
        "quarantined",
        "archived"
      ],
      "title": "SkillActivationState",
      "type": "string"
    },
    "SkillSourceKind": {
      "enum": [
        "bundled",
        "project",
        "operator",
        "community",
        "source_control",
        "url",
        "hub"
      ],
      "title": "SkillSourceKind",
      "type": "string"
    },
    "SkillTrustState": {
      "enum": [
        "untrusted",
        "trusted",
        "quarantined"
      ],
      "title": "SkillTrustState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "default_activation": {
      "$ref": "#/$defs/SkillActivationState"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/$defs/SkillSourceKind"
    },
    "package_activation": {
      "additionalProperties": {
        "$ref": "#/$defs/SkillActivationState"
      },
      "title": "Package Activation",
      "type": "object"
    },
    "precedence": {
      "maximum": 1000000,
      "minimum": -1000000,
      "title": "Precedence",
      "type": "integer"
    },
    "revision": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "trust": {
      "$ref": "#/$defs/SkillTrustState"
    },
    "uri": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "kind",
    "uri",
    "revision",
    "precedence",
    "trust",
    "default_activation"
  ],
  "title": "SkillSourceDefinition",
  "type": "object"
}
