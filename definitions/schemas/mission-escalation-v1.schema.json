{
  "$defs": {
    "EscalationOption": {
      "additionalProperties": false,
      "properties": {
        "consequences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Consequences",
          "type": "array"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Risks",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "description",
        "consequences",
        "risks"
      ],
      "title": "EscalationOption",
      "type": "object"
    },
    "EscalationState": {
      "enum": [
        "open",
        "answered",
        "resolved",
        "withdrawn"
      ],
      "title": "EscalationState",
      "type": "string"
    },
    "ExecutiveRecommendation": {
      "additionalProperties": false,
      "properties": {
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence References",
          "type": "array"
        },
        "identity_id": {
          "enum": [
            "PM",
            "CTO"
          ],
          "title": "Identity Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "recommended_option_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Recommended Option Id",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "recommended_option_id",
        "rationale",
        "evidence_references"
      ],
      "title": "ExecutiveRecommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_intervention_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Intervention Id"
    },
    "blocked_scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Blocked Scope",
      "type": "array"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "decision_required": {
      "maxLength": 8192,
      "minLength": 3,
      "title": "Decision Required",
      "type": "string"
    },
    "escalation_id": {
      "format": "uuid",
      "title": "Escalation Id",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence References",
      "type": "array"
    },
    "independent_work_continuing": {
      "items": {
        "type": "string"
      },
      "title": "Independent Work Continuing",
      "type": "array"
    },
    "mission_id": {
      "format": "uuid",
      "title": "Mission Id",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/EscalationOption"
      },
      "minItems": 2,
      "title": "Options",
      "type": "array"
    },
    "raised_by": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Raised By",
      "type": "string"
    },
    "reason": {
      "maxLength": 8192,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/ExecutiveRecommendation"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/EscalationState",
      "default": "open"
    },
    "uncertainty": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Uncertainty",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "mission_id",
    "conversation_id",
    "raised_by",
    "blocked_scope",
    "decision_required",
    "reason",
    "options",
    "recommendations",
    "uncertainty",
    "independent_work_continuing",
    "evidence_references"
  ],
  "title": "MissionEscalation",
  "type": "object"
}
