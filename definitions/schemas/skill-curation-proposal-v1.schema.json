{
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "archive",
      "default": "archive",
      "title": "Action",
      "type": "string"
    },
    "last_used_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Used At"
    },
    "reason": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Skill Name",
      "type": "string"
    },
    "skill_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Skill Version",
      "type": "string"
    },
    "stale_after_days": {
      "maximum": 36500,
      "minimum": 1,
      "title": "Stale After Days",
      "type": "integer"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "skill_name",
    "skill_version",
    "stale_after_days",
    "reason"
  ],
  "title": "SkillCurationProposal",
  "type": "object"
}
