{
  "$defs": {
    "GitEffectMode": {
      "enum": [
        "stage",
        "commit",
        "push",
        "force_with_lease",
        "force_push"
      ],
      "title": "GitEffectMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author_email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Email"
    },
    "author_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Name"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch"
    },
    "credential_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Reference"
    },
    "expected_head": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Head"
    },
    "expected_remote_oid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Remote Oid"
    },
    "expected_remote_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Remote Url"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "mode": {
      "$ref": "#/$defs/GitEffectMode"
    },
    "paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Paths",
      "type": "array"
    },
    "remote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remote"
    },
    "require_clean_worktree": {
      "default": false,
      "title": "Require Clean Worktree",
      "type": "boolean"
    },
    "timeout_seconds": {
      "default": 120,
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "workspace": {
      "format": "path",
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "workspace"
  ],
  "title": "GitEffectRequest",
  "type": "object"
}
