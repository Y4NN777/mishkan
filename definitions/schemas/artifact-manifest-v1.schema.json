{
  "$defs": {
    "ArtifactAvailability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "ArtifactAvailability",
      "type": "string"
    },
    "ArtifactFactState": {
      "enum": [
        "not_evaluated",
        "passed",
        "failed"
      ],
      "title": "ArtifactFactState",
      "type": "string"
    },
    "ArtifactFacts": {
      "additionalProperties": false,
      "description": "Independent evidence dimensions; none grants use authority.",
      "properties": {
        "authorization": {
          "const": "contextual_policy_required",
          "default": "contextual_policy_required",
          "title": "Authorization",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/ArtifactAvailability",
          "default": "unavailable"
        },
        "detected_media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected Media Type"
        },
        "integrity": {
          "$ref": "#/$defs/ArtifactFactState",
          "default": "not_evaluated"
        },
        "rendering": {
          "$ref": "#/$defs/ArtifactFactState",
          "default": "not_evaluated"
        },
        "schema_validity": {
          "$ref": "#/$defs/ArtifactFactState",
          "default": "not_evaluated"
        },
        "security_scan": {
          "$ref": "#/$defs/ArtifactFactState",
          "default": "not_evaluated"
        },
        "sensitivity": {
          "minLength": 1,
          "title": "Sensitivity",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/ArtifactTrust",
          "default": "untrusted"
        }
      },
      "required": [
        "sensitivity"
      ],
      "title": "ArtifactFacts",
      "type": "object"
    },
    "ArtifactLifecycle": {
      "enum": [
        "staging",
        "validating",
        "available",
        "quarantined",
        "rejected",
        "expired",
        "missing",
        "corrupt",
        "tombstoned",
        "deleted"
      ],
      "title": "ArtifactLifecycle",
      "type": "string"
    },
    "ArtifactProvenance": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "channel": {
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$",
          "title": "Channel",
          "type": "string"
        },
        "configuration_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Fingerprint"
        },
        "declared_loss": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Loss"
        },
        "engine": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "engine_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Version"
        },
        "producer_identity": {
          "minLength": 1,
          "title": "Producer Identity",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifacts",
          "type": "array"
        },
        "task_attempt_id": {
          "minLength": 1,
          "title": "Task Attempt Id",
          "type": "string"
        }
      },
      "required": [
        "producer_identity",
        "run_id",
        "task_attempt_id",
        "call_id",
        "capability",
        "channel"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ArtifactTrust": {
      "enum": [
        "untrusted",
        "trusted",
        "quarantined"
      ],
      "title": "ArtifactTrust",
      "type": "string"
    },
    "ArtifactValidation": {
      "enum": [
        "integrity_verified",
        "partial"
      ],
      "title": "ArtifactValidation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "const": "unaccepted",
      "default": "unaccepted",
      "title": "Acceptance",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_media_type": {
      "minLength": 1,
      "title": "Declared Media Type",
      "type": "string"
    },
    "detected_media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detected Media Type"
    },
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "facts": {
      "$ref": "#/$defs/ArtifactFacts"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/ArtifactLifecycle"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "retention": {
      "minLength": 1,
      "title": "Retention",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "minLength": 1,
      "title": "Sensitivity",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "storage_ref": {
      "pattern": "^sha256/[a-f0-9]{2}/[a-f0-9]{62}$",
      "title": "Storage Ref",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ArtifactValidation"
    }
  },
  "required": [
    "digest",
    "size_bytes",
    "declared_media_type",
    "provenance",
    "sensitivity",
    "retention",
    "validation",
    "lifecycle",
    "storage_ref"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
