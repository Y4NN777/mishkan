{
  "$defs": {
    "SkillActivationState": {
      "enum": [
        "candidate",
        "active",
        "inactive",
        "quarantined",
        "archived"
      ],
      "title": "SkillActivationState",
      "type": "string"
    },
    "SkillMetadata": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "$ref": "#/$defs/SkillActivationState"
        },
        "allowed_tools_hint": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools Hint"
        },
        "author_claim": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Claim"
        },
        "compatibility_summary": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibility Summary"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fallback_tools": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Fallback Tools",
          "type": "object"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "organization_versions": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Organization Versions",
          "type": "array"
        },
        "package_fingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Package Fingerprint",
          "type": "string"
        },
        "package_uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Package Uri",
          "type": "string"
        },
        "platforms": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "required_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Tools",
          "type": "array"
        },
        "resource_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resource Paths",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SkillSourceKind"
        },
        "source_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "task_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Task Classes",
          "type": "array"
        },
        "trust": {
          "$ref": "#/$defs/SkillTrustState"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "version",
        "source_id",
        "source_kind",
        "source_revision",
        "package_uri",
        "package_fingerprint",
        "trust",
        "activation"
      ],
      "title": "SkillMetadata",
      "type": "object"
    },
    "SkillSourceKind": {
      "enum": [
        "bundled",
        "project",
        "operator",
        "community",
        "source_control",
        "url",
        "hub"
      ],
      "title": "SkillSourceKind",
      "type": "string"
    },
    "SkillTrustState": {
      "enum": [
        "untrusted",
        "trusted",
        "quarantined"
      ],
      "title": "SkillTrustState",
      "type": "string"
    },
    "SkillUpdateEvidence": {
      "additionalProperties": false,
      "properties": {
        "active_fingerprint": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Fingerprint"
        },
        "active_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Version"
        },
        "active_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Version Id"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changed_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changed Fields",
          "type": "array"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skill_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Name"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SkillUpdateState"
        }
      },
      "required": [
        "source_id",
        "state",
        "reason"
      ],
      "title": "SkillUpdateEvidence",
      "type": "object"
    },
    "SkillUpdateState": {
      "enum": [
        "current",
        "update_available",
        "version_conflict",
        "untracked",
        "acquisition_required",
        "source_unavailable"
      ],
      "title": "SkillUpdateState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/SkillUpdateEvidence"
      },
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "observations"
  ],
  "title": "SkillUpdateReport",
  "type": "object"
}
