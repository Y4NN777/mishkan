        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Request Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
