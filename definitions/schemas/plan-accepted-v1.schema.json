        "matched_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Plan Fingerprint",
          "type": "string"
        },
        "policy_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "policy_revisions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Revisions",
          "type": "array"
