    "ApprovalEvidence": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "plan_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Plan Fingerprint",
          "type": "string"
        },
        "policy_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Request Fingerprint",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request_fingerprint",
        "plan_fingerprint",
        "policy_fingerprint",
        "approved_by",
        "reason"
      ],
      "title": "ApprovalEvidence",
      "type": "object"
    },
    "AuthorizationDecision": {
      "additionalProperties": false,
      "properties": {
