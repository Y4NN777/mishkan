{
  "additionalProperties": false,
  "properties": {
    "artifact_reference": {
      "pattern": "^artifact:[0-9a-f-]{36}$",
      "title": "Artifact Reference",
      "type": "string"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "extractor_id": {
      "title": "Extractor Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    }
  },
  "required": [
    "artifact_reference",
    "source_url",
    "extractor_id"
  ],
  "title": "ExtractionRequest",
  "type": "object"
}
