{
  "$defs": {
    "McpCallState": {
      "enum": [
        "reserved",
        "dispatching",
        "running",
        "completed",
        "failed",
        "cancel_requested",
        "cancelled",
        "lost",
        "uncertain"
      ],
      "title": "McpCallState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "content_artifact_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Content Artifact References",
      "type": "array"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "primitive_name": {
      "title": "Primitive Name",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "remote_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remote Task Id"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_hash": {
      "title": "Schema Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/McpCallState"
    }
  },
  "required": [
    "request_id",
    "connection_id",
    "primitive_name",
    "state",
    "schema_hash",
    "reason"
  ],
  "title": "McpCallResult",
  "type": "object"
}
