{
  "$defs": {
    "RecommendationCriterion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "weight"
      ],
      "title": "RecommendationCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Candidate Ids",
      "type": "array"
    },
    "context_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/RecommendationCriterion"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "owner_identity": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Identity",
      "type": "string"
    },
    "project_evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Project Evidence",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "owner_identity",
    "context_id",
    "candidate_ids",
    "criteria",
    "project_evidence"
  ],
  "title": "ContextualRecommendationRequest",
  "type": "object"
}
