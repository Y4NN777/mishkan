{
  "$defs": {
    "BrowserTarget": {
      "additionalProperties": false,
      "properties": {
        "candidate_effects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Effects",
          "type": "array"
        },
        "destination_origin": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Origin"
        },
        "element_revision": {
          "minLength": 1,
          "title": "Element Revision",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "role",
        "name",
        "element_revision"
      ],
      "title": "BrowserTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "page_id": {
      "title": "Page Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "screenshot_artifact_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screenshot Artifact Reference"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "session_revision": {
      "minimum": 0,
      "title": "Session Revision",
      "type": "integer"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/BrowserTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "tree_artifact_reference": {
      "title": "Tree Artifact Reference",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "page_id",
    "session_revision",
    "url",
    "title",
    "targets",
    "tree_artifact_reference",
    "engine",
    "engine_version",
    "expires_at"
  ],
  "title": "BrowserObservation",
  "type": "object"
}
