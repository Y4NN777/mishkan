      "required": [
        "url",
        "depth"
      ],
      "title": "CrawlPage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "crawler_id": {
      "title": "Crawler Id",
      "type": "string"
    },
    "degraded": {
      "title": "Degraded",
      "type": "boolean"
