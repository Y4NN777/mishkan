{
  "$defs": {
    "SkillBundleMode": {
      "enum": [
        "all",
        "select"
      ],
      "title": "SkillBundleMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "max_selected": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Selected"
    },
    "mode": {
      "$ref": "#/$defs/SkillBundleMode"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Skills",
      "type": "array"
    },
    "summary": {
      "maxLength": 1024,
      "minLength": 3,
      "title": "Summary",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "version",
    "summary",
    "mode",
    "skills"
  ],
  "title": "SkillBundleDefinition",
  "type": "object"
}
