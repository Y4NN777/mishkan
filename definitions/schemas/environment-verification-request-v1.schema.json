{
  "additionalProperties": false,
  "properties": {
    "binding_id": {
      "format": "uuid",
      "title": "Binding Id",
      "type": "string"
    },
    "check_attempt_ids": {
      "additionalProperties": {
        "items": {
          "format": "uuid",
          "type": "string"
