{
  "$defs": {
    "LearningScopeLevel": {
      "enum": [
        "mission",
        "project",
        "agent",
        "branch",
        "organization"
      ],
      "title": "LearningScopeLevel",
      "type": "string"
    },
    "ProfessionalEvidenceKind": {
      "enum": [
        "project_knowledge",
        "tool_mastery",
        "skill_association",
        "demonstrated_competence"
      ],
      "title": "ProfessionalEvidenceKind",
      "type": "string"
    },
    "ProfessionalLearningScope": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/LearningScopeLevel"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "level",
        "scope_id"
      ],
      "title": "ProfessionalLearningScope",
      "type": "object"
    },
    "ProfessionalPromotionDisposition": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "ProfessionalPromotionDisposition",
      "type": "string"
    },
    "ProfessionalPromotionRequest": {
      "additionalProperties": false,
      "properties": {
        "identity_id": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Identity Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProfessionalEvidenceKind"
        },
        "rationale": {
          "maxLength": 8192,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Requested By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_scope": {
          "$ref": "#/$defs/ProfessionalLearningScope"
        },
        "subject": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "target_scope": {
          "$ref": "#/$defs/ProfessionalLearningScope"
        }
      },
      "required": [
        "identity_id",
        "kind",
        "subject",
        "source_scope",
        "target_scope",
        "supporting_evidence_ids",
        "requested_by",
        "rationale"
      ],
      "title": "ProfessionalPromotionRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contradictory_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Contradictory Evidence Ids",
      "type": "array"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Decided By",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/ProfessionalPromotionDisposition"
    },
    "failure_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Failure Evidence Ids",
      "type": "array"
    },
    "policy_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "previous_decision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Decision Id"
    },
    "reason": {
      "maxLength": 8192,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ProfessionalPromotionRequest"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Supporting Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "request",
    "disposition",
    "revision",
    "supporting_evidence_ids",
    "contradictory_evidence_ids",
    "failure_evidence_ids",
    "decided_by",
    "policy_fingerprint",
    "reason"
  ],
  "title": "ProfessionalPromotionDecision",
  "type": "object"
}
