{
  "$defs": {
    "SessionMode": {
      "enum": [
        "pty",
        "job"
      ],
      "title": "SessionMode",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "starting",
        "running",
        "ready",
        "cancelling",
        "settled",
        "failed",
        "lost",
        "uncertain"
      ],
      "title": "SessionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cancellation_requested": {
      "default": false,
      "title": "Cancellation Requested",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "mode": {
      "$ref": "#/$defs/SessionMode"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pid"
    },
    "process_create_time": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Process Create Time"
    },
    "process_group_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Process Group Id"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "signal": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal"
    },
    "state": {
      "$ref": "#/$defs/SessionState"
    },
    "stderr_artifact_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stderr Artifact Reference"
    },
    "stderr_cursor": {
      "minimum": 0,
      "title": "Stderr Cursor",
      "type": "integer"
    },
    "stdout_artifact_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stdout Artifact Reference"
    },
    "stdout_cursor": {
      "minimum": 0,
      "title": "Stdout Cursor",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "mode",
    "state",
    "owner",
    "run_id",
    "task_id",
    "pid",
    "process_group_id",
    "process_create_time",
    "stdout_cursor",
    "stderr_cursor",
    "created_at",
    "updated_at"
  ],
  "title": "SessionRecord",
  "type": "object"
}
