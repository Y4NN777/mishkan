{
  "$defs": {
    "SearchStrategy": {
      "enum": [
        "direct",
        "aggregate",
        "verification",
        "automatic"
      ],
      "title": "SearchStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "language": {
      "anyOf": [
        {
          "maxLength": 35,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "limit": {
      "default": 10,
      "maximum": 1000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "query": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "safe_search": {
      "default": 1,
      "maximum": 2,
      "minimum": 0,
      "title": "Safe Search",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "strategy": {
      "$ref": "#/$defs/SearchStrategy"
    },
    "time_range": {
      "anyOf": [
        {
          "pattern": "^(day|month|year)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Range"
    }
  },
  "required": [
    "query",
    "strategy"
  ],
  "title": "SearchRequest",
  "type": "object"
}
