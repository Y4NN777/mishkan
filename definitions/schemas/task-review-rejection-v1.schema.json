{
  "$defs": {
    "InitializationResult": {
      "additionalProperties": false,
      "properties": {
        "cited_paths": {
          "description": "Exact repository-relative evidence paths from the accepted task.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cited Paths",
          "type": "array"
        },
        "execution_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanExecutionContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "findings": {
          "description": "Factual findings directly supported by the cited repository paths.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "repository_revision": {
          "anyOf": [
            {
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Summary",
          "type": "string"
        },
        "task_id": {
          "minLength": 2,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "summary",
        "cited_paths",
        "findings"
      ],
      "title": "InitializationResult",
      "type": "object"
    },
    "PlanExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 256,
          "minLength": 12,
          "title": "Context Id",
          "type": "string"
        },
        "discovery_revision": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Revision"
        },
        "kind": {
          "enum": [
            "repository",
            "prospective_workspace"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prospective_workspace_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prospective Workspace Id"
        },
        "repository_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Id"
        },
        "repository_revision": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 7,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "context_id",
        "revision"
      ],
      "title": "PlanExecutionContext",
      "type": "object"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "checked_citations": {
          "description": "Exact repository-relative path strings copied from the proposed result's cited_paths; never findings or explanations.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Checked Citations",
          "type": "array"
        },
        "evaluator_identity": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Identity"
        },
        "issues": {
          "default": [],
          "description": "Concrete evidence or contract defects; empty when the verdict is accepted.",
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "producer_identity": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Identity"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Summary",
          "type": "string"
        },
        "task_id": {
          "minLength": 2,
          "title": "Task Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "verdict",
        "summary",
        "checked_citations"
      ],
      "title": "ReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable evidence for one independently rejected task-result proposal.",
  "properties": {
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/InitializationResult"
    },
    "review": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "review_sequence": {
      "minimum": 1,
      "title": "Review Sequence",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_attempt": {
      "minimum": 1,
      "title": "Task Attempt",
      "type": "integer"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "task_attempt",
    "review_sequence",
    "result",
    "review",
    "recorded_at"
  ],
  "title": "TaskReviewRejection",
  "type": "object"
}
