        "organization_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Organization Version",
          "type": "string"
        },
        "platform": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "task_class": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Class",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
